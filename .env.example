# Copy to .env and adjust: cp .env.example .env

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=authdb

# JWT signing secret (HS256) - at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Token lifetime = inactivity timeout (Go duration format: 15m, 1m, 30s)
JWT_TTL=15m

# Swagger UI at http://localhost:8080/swagger/ - set to false (or remove) in production
SWAGGER_ENABLED=true

# Create demo users admin@medika.com, cs@medika.com, perawat@medika.com (password Medika123)
# on startup if they do not exist. Set to false (or remove) in production
SEED_DEMO_USERS=true

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
